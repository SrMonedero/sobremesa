---
// The content admin, behind Cloudflare Access. It uses Quique's own design
// system (Papel + Cian, Atkinson), not the public site's Azulejo look.
import '@fontsource-variable/atkinson-hyperlegible-next';
import '@fontsource-variable/atkinson-hyperlegible-mono';
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex" />
    <title>Panel · Sobremesa</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <style is:global>
      :root {
        --bg: #F5F2EC; --surface: #FCFAF7; --line: #DFDCD6; --line-strong: #C5C2BC;
        --fg: #181611; --fg-muted: #4F4D48; --fg-subtle: #696661;
        --accent: #0099C6; --accent-hover: #0E85AC; --accent-fg: #001924; --accent-soft: #DCE7E8; --accent-text: #006C8E;
        --success: #2B6B3A; --success-soft: #E2F0E4; --warning: #8A5300; --warning-soft: #FBEFD9; --danger: #B42318; --danger-soft: #FBE5E2;
        --shadow-float: 0 8px 24px -8px rgb(24 22 17 / .18), 0 1px 2px rgb(24 22 17 / .08);
        --sans: "Atkinson Hyperlegible Next Variable", "Atkinson Hyperlegible Next", ui-sans-serif, sans-serif;
        --mono: "Atkinson Hyperlegible Mono Variable", "Atkinson Hyperlegible Mono", ui-monospace, monospace;
        color-scheme: light;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #12100D; --surface: #1A1915; --line: #292723; --line-strong: #3F3D38;
          --fg: #ECEBE8; --fg-muted: #BFBDBA; --fg-subtle: #8E8C88;
          --accent: #0099C6; --accent-hover: #2DACDA; --accent-fg: #001924; --accent-soft: #1B282D; --accent-text: #0C9CC9;
          --success: #6CCB85; --success-soft: #163020; --warning: #F2B44C; --warning-soft: #36280F; --danger: #F7806F; --danger-soft: #3B1714;
          --shadow-float: 0 8px 24px -8px rgb(0 0 0 / .6), 0 0 0 1px #292723;
          color-scheme: dark;
        }
      }
      * { box-sizing: border-box; }
      html, body { height: 100%; }
      body { margin: 0; background: var(--bg); color: var(--fg); font-family: var(--sans); font-size: 16px; line-height: 1.5; }
      button, input, select, textarea { font: inherit; color: inherit; }
      :focus-visible { outline: 2px solid var(--accent-text); outline-offset: 2px; }
      a { color: var(--accent-text); }

      .app { display: grid; grid-template-rows: auto 1fr; height: 100%; }
      .bar { display: flex; align-items: center; gap: 16px; padding: 12px max(20px, env(safe-area-inset-right, 0px)) 12px max(20px, env(safe-area-inset-left, 0px)); border-bottom: 1px solid var(--line); background: var(--surface); flex-wrap: wrap; }
      .bar h1 { margin: 0; font-size: 20px; line-height: 28px; font-weight: 700; letter-spacing: -0.02em; }
      .bar .spacer { flex: 1; }
      .bar .who { font-family: var(--mono); font-size: 12px; text-transform: uppercase; letter-spacing: .06em; color: var(--fg-subtle); }
      .status { font-size: 14px; color: var(--fg-muted); display: flex; align-items: center; gap: 8px; }
      .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--fg-subtle); }
      .dot.ok { background: var(--success); } .dot.run { background: var(--warning); } .dot.err { background: var(--danger); }

      .main { display: grid; grid-template-columns: 320px minmax(0, 1fr); min-height: 0; }
      .side { border-right: 1px solid var(--line); display: grid; grid-template-rows: auto auto 1fr; min-height: 0; background: var(--surface); }
      .tabs { display: flex; border-bottom: 1px solid var(--line); }
      .tabs button { flex: 1; height: 44px; background: none; border: 0; border-bottom: 2px solid transparent; cursor: pointer; font-weight: 500; color: var(--fg-muted); }
      .tabs button[aria-selected="true"] { color: var(--fg); border-bottom-color: var(--accent); }
      .tools { display: flex; gap: 8px; padding: 12px; border-bottom: 1px solid var(--line); }
      .tools input { flex: 1; min-width: 0; }
      .list { overflow-y: auto; margin: 0; padding: 0; list-style: none; }
      .list li button { width: 100%; text-align: left; background: none; border: 0; border-bottom: 1px solid var(--line); padding: 10px 16px; cursor: pointer; display: grid; gap: 2px; min-height: 44px; }
      .list li button:hover { background: var(--bg); }
      .list li button[aria-current="true"] { background: var(--accent-soft); }
      .list .name { font-weight: 600; display: flex; gap: 8px; align-items: center; }
      .list .sub { font-size: 14px; color: var(--fg-subtle); }
      .badges { display: flex; gap: 4px; flex-wrap: wrap; }
      .badge { font-family: var(--mono); font-size: 12px; line-height: 16px; text-transform: uppercase; letter-spacing: .06em; padding: 1px 6px; border-radius: 3px; background: var(--bg); color: var(--fg-muted); border: 1px solid var(--line); }
      .badge.warn { background: var(--warning-soft); color: var(--warning); border-color: transparent; }
      .badge.new { background: var(--accent-soft); color: var(--accent-text); border-color: transparent; }

      .editor { overflow-y: auto; padding: 32px max(24px, env(safe-area-inset-right, 0px)) 80px 32px; }
      .editor form, .editor .regions-edit { max-width: 760px; display: grid; gap: 32px; }
      .editor h2 { margin: 0; font-size: 28px; line-height: 32px; font-weight: 700; letter-spacing: -0.02em; }
      .head { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
      .head .spacer { flex: 1; }
      fieldset { border: 0; padding: 0; margin: 0; display: grid; gap: 16px; }
      legend { font-family: var(--mono); font-size: 12px; text-transform: uppercase; letter-spacing: .08em; color: var(--fg-subtle); padding: 0 0 12px; border-bottom: 1px solid var(--line); width: 100%; margin-bottom: 4px; }
      .field { display: grid; gap: 6px; }
      .field > span { font-size: 14px; font-weight: 500; }
      .help { font-size: 14px; color: var(--fg-subtle); margin: 0; }
      .row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
      input[type=text], input[type=search], select, textarea { width: 100%; min-height: 40px; padding: 8px 12px; border-radius: 6px; border: 1px solid var(--line); background: var(--bg); }
      input:hover, select:hover, textarea:hover { border-color: var(--line-strong); }
      ::placeholder { color: var(--fg-subtle); opacity: .7; }
      textarea { resize: vertical; min-height: 96px; line-height: 1.55; }
      textarea.tall { min-height: 180px; }
      .checks { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 6px 16px; }
      .check { display: flex; gap: 8px; align-items: center; font-size: 14px; min-height: 28px; cursor: pointer; }
      input[type=checkbox] { accent-color: var(--accent); width: 16px; height: 16px; }

      .btn { height: 40px; padding: 0 14px; border-radius: 6px; border: 1px solid var(--line-strong); background: var(--surface); cursor: pointer; font-weight: 500; display: inline-flex; align-items: center; gap: 8px; white-space: nowrap; text-decoration: none; color: var(--fg); }
      .btn:hover { background: var(--bg); }
      .btn.primary { background: var(--accent); color: var(--accent-fg); border-color: var(--line-strong); }
      .btn.primary:hover { background: var(--accent-hover); }
      .btn.ghost { border-color: transparent; background: none; }
      .btn.danger { background: var(--danger); color: #fff; border-color: transparent; }
      .btn.small { height: 32px; padding: 0 10px; font-size: 14px; }
      .btn:disabled { opacity: .5; cursor: default; }

      .photo { display: grid; grid-template-columns: 220px 1fr; gap: 16px; align-items: start; }
      .photo .preview { aspect-ratio: 4 / 3; border-radius: 6px; border: 1px solid var(--line); background: var(--bg); overflow: hidden; display: grid; place-items: center; color: var(--fg-subtle); font-size: 14px; }
      .photo .preview img { width: 100%; height: 100%; object-fit: cover; display: block; }
      .photo .actions { display: grid; gap: 12px; }

      .confirm { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; padding: 12px; border-radius: 6px; background: var(--danger-soft); color: var(--danger); font-size: 14px; }
      .msg { padding: 10px 14px; border-radius: 6px; font-size: 14px; }
      .msg.err { background: var(--danger-soft); color: var(--danger); }
      .msg.ok { background: var(--success-soft); color: var(--success); }
      .toast { position: fixed; right: max(20px, env(safe-area-inset-right, 0px)); bottom: max(20px, env(safe-area-inset-bottom, 0px)); background: var(--surface); border: 1px solid var(--line); box-shadow: var(--shadow-float); padding: 12px 16px; border-radius: 6px; font-size: 14px; max-width: 360px; }
      .empty { color: var(--fg-subtle); padding: 32px 0; }
      .region-row { display: grid; gap: 6px; padding: 16px 0; border-bottom: 1px solid var(--line); }
      .region-row .rname { font-weight: 600; display: flex; gap: 8px; align-items: baseline; }
      .region-row .rname small { font-family: var(--mono); font-size: 12px; color: var(--fg-subtle); }
      .loading { padding: 40px; color: var(--fg-subtle); }

      @media (max-width: 820px) {
        .main { grid-template-columns: 1fr; grid-template-rows: auto 1fr; }
        .side { border-right: 0; border-bottom: 1px solid var(--line); }
        .list { max-height: 34vh; }
        .editor { padding: 24px max(16px, env(safe-area-inset-right, 0px)) 80px max(16px, env(safe-area-inset-left, 0px)); }
        .row, .photo { grid-template-columns: 1fr; }
        .bar .who { display: none; }
      }
    </style>
  </head>
  <body>
    <div id="app" class="app"><div class="loading">Cargando…</div></div>
    <script src="../scripts/admin.ts"></script>
  </body>
</html>
